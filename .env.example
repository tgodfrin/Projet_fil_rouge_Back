# .env.example — modele de configuration de PRODUCTION (VM ecole).
# Copier ce fichier en `.env` sur la VM (dossier ~/locmns) puis renseigner les vraies valeurs.
# Le `.env` reel n'est JAMAIS commite (cf .gitignore) ; ce `.env.example`, si (sans secrets).
# Utilise par docker-compose.prod.yml.

# --- Docker Hub : compte d'ou sont tirees les images locmns-back / locmns-front ---
DOCKERHUB_USERNAME=mon-compte-dockerhub

# --- Base de donnees PostgreSQL ---
# Le back construit l'URL : jdbc:postgresql://postgres:5432/${POSTGRES_DB}
POSTGRES_DB=locmns
POSTGRES_USER=locmns_user
POSTGRES_PASSWORD=a-remplacer-par-un-mot-de-passe-fort

# --- Securite JWT (HS256) ---
# Chaine aleatoire d'au moins 32 caracteres (256 bits). Ne jamais reutiliser celle de dev.
JWT_SECRET=a-remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# --- CORS : origines autorisees (separees par des virgules) ---
# En prod, nginx sert front + back en same-origin (pas de CORS necessaire) ;
# renseigner l'URL publique si un acces cross-origin est requis.
CORS_ALLOWED_ORIGINS=https://cda-thomasg.stagiairesmns.fr

# --- SMTP : envoi des mots de passe temporaires (mot de passe oublie) ---
MAIL_USERNAME=locmns.noreply@gmail.com
MAIL_PASSWORD=a-remplacer-par-un-mot-de-passe-application-smtp
