{
  "info": {
    "name": "LOC MNS API",
    "description": "Collection complète de l'API LOC MNS (gestion du parc matériel MNS). Authentification JWT : lancer d'abord 'Authentification > POST /login' pour remplir {{token}}. Toutes les autres requêtes héritent du Bearer {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "POST /login (gestionnaire)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.martin@mns.fr\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Authentifie et stocke le JWT dans la variable {{token}} (utilisée par toutes les autres requêtes)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Le endpoint /login renvoie le JWT en texte brut (pas du JSON).",
                  "if (pm.response.code === 200) {",
                  "    const jwt = pm.response.text();",
                  "    pm.collectionVariables.set('token', jwt);",
                  "    pm.environment.set('token', jwt);",
                  "    pm.test('Token JWT enregistré', () => pm.expect(jwt.length).to.be.above(10));",
                  "} else {",
                  "    pm.test('Login 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /login (collaborateur)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
