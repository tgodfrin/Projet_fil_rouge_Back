    {
      "name": "Scénario fil rouge (emprunt complet)",
      "item": [
        {
          "name": "1. Login gestionnaire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.martin@mns.fr\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Le endpoint /login renvoie le JWT en texte brut (pas du JSON).",
                  "if (pm.response.code === 200) {",
                  "    const jwt = pm.response.text();",
                  "    pm.collectionVariables.set('token', jwt);",
                  "    pm.environment.set('token', jwt);",
                  "    pm.test('Token JWT enregistré', () => pm.expect(jwt.length).to.be.above(10));",
                  "} else {",
                  "    pm.test('Login 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Catalogue disponible sur la période",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipment/catalogue/available?begin={{beginDate}}&end={{endDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "catalogue",
                "available"
              ],
              "query": [
                {
                  "key": "begin",
                  "value": "{{beginDate}}"
                },
                {
                  "key": "end",
                  "value": "{{endDate}}"
                }
              ]
            },
            "description": "Récupère les équipements disponibles et stocke le 1er id dans {{equipmentId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "const list = pm.response.json();",
                  "pm.test('Au moins un équipement disponible', () => pm.expect(list.length).to.be.above(0));",
                  "if (list.length > 0) {",
                  "    pm.collectionVariables.set('equipmentId', list[0].id);",
                  "    pm.environment.set('equipmentId', list[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Créer la demande d'emprunt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beginDate\": \"{{beginDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"groupId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Crée l'emprunt (statut IN_PROGRESS) et stocke son id dans {{loanId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.expect(pm.response.code).to.eql(201));",
                  "const loan = pm.response.json();",
                  "pm.collectionVariables.set('loanId', loan.id);",
                  "    pm.environment.set('loanId', loan.id);",
                  "pm.test('Statut IN_PROGRESS', () => pm.expect(loan.statusType).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Valider la demande",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/loan/{{loanId}}/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loan",
                "{{loanId}}",
                "validate"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.expect(pm.response.code).to.eql(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Enregistrer le retour",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/loan/{{loanId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loan",
                "{{loanId}}",
                "return"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.expect(pm.response.code).to.eql(204));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Parcours bout en bout de la fonctionnalité fil rouge : connexion, recherche d'un équipement disponible, demande d'emprunt, validation puis retour. À lancer dans l'ordre (ou via le Collection Runner)."
    }
