            "description": "Connexion d'un emprunteur. Ajuste le mot de passe si besoin selon ton data.sql."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Le endpoint /login renvoie le JWT en texte brut (pas du JSON).",
                  "if (pm.response.code === 200) {",
                  "    const jwt = pm.response.text();",
                  "    pm.collectionVariables.set('token', jwt);",
                  "    pm.environment.set('token', jwt);",
                  "    pm.test('Token JWT enregistré', () => pm.expect(jwt.length).to.be.above(10));",
                  "} else {",
                  "    pm.test('Login 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "}"
                ]
              }
            }
          ]
        },
